{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "declaration": true,
    "esModuleInterop": true,
    "inlineSources": true,
    "lib": ["dom", "es2017", "es2022.error"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "./src",
    "outDir": "dist/esm",
    "pretty": true,
    "sourceMap": true,
    "importHelpers": true,
    "strict": true,
    "target": "es2017",
    "types": ["google.accounts", "@capacitor/core"]
  },
  "files": ["src/index.ts"]
}
