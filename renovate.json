{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Cap-go/.github:renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "com.google.androidbrowserhelper:androidbrowserhelper"
      ],
      "matchManagers": [
        "gradle"
      ],
      "enabled": false
    }
  ]
}
